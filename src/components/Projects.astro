---
import { getEntry } from "astro:content";
import type { Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = (await getEntry("projects", locale))!.data.featured;

const linkClass =
  "inline-flex items-center gap-1.5 font-mono text-label text-primary transition-colors hover:text-accent";
---

<section id="projects" class="scroll-mt-20">
  <div class="mx-auto w-full max-w-page px-4 py-16 md:px-8 md:py-24">
    <h2 class="sr-only">{t("section.projects")}</h2>
    <p
      class="reveal flex items-center gap-2 border-b border-border pb-4 font-mono text-label text-muted"
    >
      <span class="text-primary">#</span> import &#123; case_studies &#125; from
      '#/lib/projects'
    </p>

    <div class="mt-8 grid gap-6 lg:grid-cols-1">
      {
        projects.map((project, i) => (
          <article
            class="reveal rounded-lg border border-border bg-surface p-6 md:p-8 transition-colors hover:border-primary/40"
            data-reveal-delay={i * 60}
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <span class="font-mono text-label text-faint">
                  [case_{String(i + 1).padStart(2, "0")}]
                </span>
                <h3 class="mt-3 text-subhead text-text">{project.title}</h3>
                <p class="mt-2 max-w-2xl text-small text-muted">
                  {project.summary}
                </p>
                {project.context && (
                  <p class="mt-2 max-w-2xl font-mono text-label text-faint">
                    {project.context}
                  </p>
                )}
              </div>
              <div class="flex flex-wrap gap-3">
                {project.demoUrl && (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={linkClass}
                  >
                    {t("projects.demo")} &#8599;
                  </a>
                )}
                {project.repoUrl && (
                  <a
                    href={project.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={linkClass}
                  >
                    {t("projects.repo")} &#8599;
                  </a>
                )}
              </div>
            </div>

            <dl class="mt-6 grid gap-4 sm:grid-cols-2">
              <div>
                <dt class="font-mono text-label text-primary">
                  {t("projects.problem")}
                </dt>
                <dd class="mt-1 text-small text-muted">{project.problem}</dd>
              </div>
              <div>
                <dt class="font-mono text-label text-primary">
                  {t("projects.approach")}
                </dt>
                <dd class="mt-1 text-small text-muted">{project.approach}</dd>
              </div>
              <div>
                <dt class="font-mono text-label text-primary">
                  {t("projects.challenge")}
                </dt>
                <dd class="mt-1 text-small text-muted">{project.challenge}</dd>
              </div>
              <div>
                <dt class="font-mono text-label text-primary">
                  {t("projects.outcome")}
                </dt>
                <dd class="mt-1 text-small text-muted">{project.outcome}</dd>
              </div>
            </dl>

            {project.differently && (
              <p class="mt-4 text-small text-faint">
                <span class="font-mono text-label text-muted">
                  {t("projects.differently")}:
                </span>{" "}
                {project.differently}
              </p>
            )}

            {(project.stack.length > 0 || project.tags.length > 0) && (
              <ul class="mt-5 flex flex-wrap gap-2">
                {project.stack.map((tag) => (
                  <li class="rounded border border-primary/20 bg-primary/10 px-2 py-0.5 font-mono text-label text-primary">
                    {tag}
                  </li>
                ))}
                {project.tags.map((tag) => (
                  <li class="rounded border border-border bg-surface-2 px-2 py-0.5 font-mono text-label text-muted">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
