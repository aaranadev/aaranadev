---
import { getEntry } from "astro:content";
import type { Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const entry = await getEntry("experience", locale);
const roles = entry!.data.roles;
---

<section id="experience" class="scroll-mt-20">
  <div class="mx-auto w-full max-w-page px-4 py-16 md:px-8 md:py-24">
    <h2 class="sr-only">{t("section.experience")}</h2>
    <p
      class="reveal flex items-center gap-2 border-b border-border pb-4 font-mono text-label text-muted"
    >
      <span class="text-primary">&#8635;</span> fetch('/api/career_history')
    </p>

    <ol class="mt-8 space-y-6">
      {
        roles.map((r) => (
          <li class="reveal relative rounded-lg border border-border bg-surface p-6 pl-7">
            <span
              class:list={[
                "absolute top-6 bottom-6 left-0 w-0.5 rounded-r",
                r.current ? "bg-primary" : "bg-border-strong",
              ]}
              aria-hidden="true"
            />
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <h3 class="text-subhead text-text">{r.title}</h3>
                <p class="mt-1 font-mono text-label text-muted">
                  company: <span class="text-accent">"{r.company}"</span>
                </p>
              </div>
              <span class="font-mono text-label text-faint">{r.period}</span>
            </div>
            <p class="mt-3 text-small text-muted">{r.summary}</p>
            {r.highlights.length > 0 && (
              <ul class="mt-3 list-disc space-y-1 pl-5 text-small text-muted">
                {r.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            {r.tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {r.tags.map((tag) => (
                  <li class="rounded border border-border bg-surface-2 px-2 py-0.5 font-mono text-label text-muted">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
