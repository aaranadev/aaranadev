---
import { localizedPath, type Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import MobileMenu from "./MobileMenu.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localizedPath("/", locale);

const navItems = [
  { href: "#stack", label: ".stack" },
  { href: "#experience", label: ".experience" },
  { href: "#contact", label: ".contact" },
];
---

<header
  class="sticky top-0 z-40 border-b border-border bg-canvas/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex h-16 w-full max-w-page items-center justify-between gap-4 px-4 md:px-8"
  >
    <a
      href={home}
      class="inline-flex items-center gap-2.5 font-mono text-label text-muted transition-colors hover:text-text"
    >
      <Logo class="size-7 text-text" />
      <span class="hidden sm:inline">portfolio@aaranadev</span>
    </a>

    <nav
      aria-label={t("a11y.primaryNav")}
      class="hidden items-center gap-7 md:flex"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="font-mono text-label tracking-wider text-muted transition-colors hover:text-primary"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle locale={locale} />
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t("a11y.openMenu")}
        class="inline-flex size-9 items-center justify-center rounded border border-border bg-surface text-muted transition-colors hover:text-text md:hidden"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<MobileMenu locale={locale} navItems={navItems} />
