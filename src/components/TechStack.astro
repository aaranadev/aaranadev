---
import { getEntry } from "astro:content";
import type { Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const entry = await getEntry("skills", locale);
const modules = entry!.data.modules;
---

<section id="stack" class="scroll-mt-20">
  <div class="mx-auto w-full max-w-page px-4 py-16 md:px-8 md:py-24">
    <h2 class="sr-only">{t("section.stack")}</h2>
    <p
      class="reveal flex items-center gap-2 border-b border-border pb-4 font-mono text-label text-muted"
    >
      <span class="text-primary">&#123;&#125;</span> import &#123; tech_stack &#125;
      from '#/lib/skills'
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        modules.map((m, i) => (
          <article
            class="reveal group rounded-lg border border-border bg-surface p-6 transition-colors hover:border-primary/40"
            data-reveal-delay={i * 60}
          >
            <span class="font-mono text-label text-faint">
              [module_{String(i + 1).padStart(2, "0")}]
            </span>
            <h3 class="mt-4 text-subhead text-text">{m.title}</h3>
            <p class="mt-2 text-small text-muted">{m.summary}</p>
            {m.tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2">
                {m.tags.map((tag) => (
                  <li class="rounded border border-primary/20 bg-primary/10 px-2 py-0.5 font-mono text-label text-primary">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
