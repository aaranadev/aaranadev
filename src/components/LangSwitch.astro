---
import { locales, localeMeta, alternatePath, type Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = "" } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
---

<div
  class:list={["flex items-center font-mono text-label", className]}
  role="group"
  aria-label={t("a11y.switchLanguage")}
>
  {
    locales.map((l, i) => (
      <Fragment>
        {i > 0 && (
          <span class="px-1.5 text-faint" aria-hidden="true">
            /
          </span>
        )}
        {l === locale ? (
          <span class="text-primary" aria-current="true">
            {localeMeta[l].short}
          </span>
        ) : (
          <a
            href={alternatePath(pathname, l)}
            hreflang={localeMeta[l].htmlLang}
            class="text-faint transition-colors hover:text-text"
          >
            {localeMeta[l].short}
          </a>
        )}
      </Fragment>
    ))
  }
</div>
